<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InvoiceGenerator\InvoiceGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Short names for the generated choice enums (their member names come from the English labels in Dataverse). -->
    <Using Include="RentMaszyny.Dataverse.Model.cr679_invoice_cr679_documentstatus" Alias="InvoiceDocumentStatus" />
    <Using Include="RentMaszyny.Dataverse.Model.cr679_invoice_cr679_language" Alias="InvoiceLanguage" />
    <Using Include="RentMaszyny.Dataverse.Model.cr679_applicationlog_cr679_severity" Alias="LogSeverity" />
  </ItemGroup>

</Project>
